# MyFreeFarm Konfiguration (Kopiere diese Datei nach .env)

# Game Account
MFF_ACCOUNT__SERVER=1
MFF_ACCOUNT__USERNAME="DeinBenutzername"
MFF_ACCOUNT__PASSWORD="DeinGeheimesPasswort"

# Application Settings
MFF_DEBUG=false
MFF_HOST="0.0.0.0"
MFF_PORT=8000
MFF_SECRET_KEY="aendere-diesen-schluessel-in-produktion-32zeichen"

# Scheduler (in Sekunden)
MFF_POLL_INTERVAL_SECONDS=600
MFF_ANTI_DETECTION_MIN_DELAY_MS=350
MFF_ANTI_DETECTION_MAX_DELAY_MS=900

# Automation Defaults
MFF_AGRICULTURE__PLANT_STRATEGY="plantQuest"
MFF_AGRICULTURE__MIN_PRODUCTS=500
MFF_AGRICULTURE__AUTO_WATER=true
MFF_AGRICULTURE__AUTO_CROP=true
MFF_AGRICULTURE__HARVEST_MODE="all"

MFF_TRADE__ENABLED=true
MFF_TRADE__MIN_CREDIT_KT=500.0
MFF_TRADE__UNDERBID_OFFSET_KT=0.01

# Stock & Purchasing (Grasping)
MFF_STOCK__BUFFER_CROPS=500
MFF_STOCK__BUFFER_OTHER=5
MFF_STOCK__MAX_PRICE_FACTOR_CROPS=1.0
MFF_STOCK__MAX_PRICE_FACTOR_OTHER=3.0
MFF_STOCK__MIN_CREDIT_KT=500.0

# Farmers Market (Bauernmarkt Dorf 2)
MFF_FARMERSMARKET__ENABLED=false
